{
  "name": "pulse-trading",
  "version": "1.0.0",
  "private": true,
  "description": "PULSE · 外汇/黄金交易记录与计算 Web 应用",
  "scripts": {
    "start": "npm run build && node server/src/index.js",
    "server": "node server/src/index.js",
    "client": "vite",
    "build": "vite build",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run client\"",
    "dev:server": "node --watch server/src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.2"
  }
}
